apiVersion: v1
kind: Secret
metadata:
  name: dnb-backend-secrets
  namespace: default
type: Opaque
stringData:
  MONGO_URI: "mongodb://user:password@mongodb:27017/dnb-backend?retryWrites=true&w=majority"
  JWT_SECRET: "replace_with_a_strong_jwt_secret_min_32_chars"
  CLOUDINARY_CLOUD_NAME: "your_cloud_name"
  CLOUDINARY_API_KEY: "your_api_key"
  CLOUDINARY_API_SECRET: "your_api_secret"
  CLOUDINARY_URL: "cloudinary://api_key:api_secret@cloud_name"
  SENDLIB_API_KEY: "your_sendlib_api_key"
  REDIS_PASSWORD: "your_redis_password"
  JITSI_MEET_DOMAIN: "your_jitsi_domain"
  JITSI_APP_ID: "your_app_id"
  JITSI_PRIVATE_KEY: "your_private_key"
  JITSI_PUBLIC_KEY_ID: "your_public_key_id"
  JITSI_KID: "your_kid"
  JITSI_TENANT: "your_tenant"
  CAPTCHA_SECRET_KEY: "your_captcha_secret_key"
  LOYALTY_CONTRACT_ID: ""
  SOROBAN_RPC_URL: ""
  DONATION_WALLET_PUBLIC_KEY: "GXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
  PLATFORM_WALLET_PUBLIC_KEY: "GXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
  FEE_SPONSOR_SECRET: ""
  STELLAR_PLATFORM_PUBLIC_KEY: ""
  ORG_NAME: ""
  ORG_URL: ""
  ORG_DESCRIPTION: ""
  ORG_LOGO: ""
  ORG_TWITTER: ""
  ORG_GITHUB: ""
  SEP10_SIGNING_SECRET: ""
  SIGNING_KEY: ""
  GIVING_ESCROW_CONTRACT_ID: ""
  AI_SERVICE_KEYS: '[{"kid":"k1","secret":"replace_with_a_long_random_secret","scopes":["ai:read-content"],"active":true}]'
  WEBHOOK_SECRET_ENCRYPTION_KEY: "replace_with_a_long_random_value"
  HIBP_RANGE_URL: "https://api.pwnedpasswords.com/range/"
  HIBP_TIMEOUT_MS: "2000"
  REDIS_USERNAME: "default"
