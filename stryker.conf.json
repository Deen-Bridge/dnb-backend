{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "reporters": [
    "html",
    "clear-text",
    "progress"
  ],
  "testRunner": "jest",
  "jest": {
    "projectType": "custom"
  },
  "mutate": [
    "mongo/utils/**/*.js",
    "mongo/mixins/**/*.js",
    "mongo/repositories/**/*.js"
  ],
  "thresholds": {
    "high": 90,
    "low": 80,
    "break": 80
  },
  "concurrency": 4
}
